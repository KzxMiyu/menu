AutoHopBtn.MouseButton1Click:Connect(function()
    if IsSearching then
        Log("⚠️ Đang tìm kiếm rồi!", Color3.fromRGB(255, 200, 0))
        return
    end

    IsSearching = true
    StopFlag = false
    HopCount = 0
    TotalFound = 0
    StartTime = tick()

    ClearLogs()

    Log("🏴‍☠️ ════════════════════════════════════", Color3.fromRGB(200, 50, 50))
    Log("🏴‍☠️  AUTO HOP - TÌM RÂU ĐEN BẮT ĐẦU!", Color3.fromRGB(200, 50, 50))
    Log("🏴‍☠️ ════════════════════════════════════", Color3.fromRGB(200, 50, 50))
    Log("", Color3.fromRGB(255, 255, 255))

    SetBigStatus("🔍", "ĐANG TÌM KIẾM...", "Scan server hiện tại trước khi hop...", Color3.fromRGB(255, 200, 0))

    -- Scan server hiện tại trước
    Log("🔍 Scan server hiện tại...", Color3.fromRGB(100, 200, 255))
    task.wait(2)

    local results, scanned = ScanForBlackbeard()
    Log("📊 Quét " .. scanned .. " objects", Color3.fromRGB(150, 150, 170))

    if #results > 0 and not StopFlag then
        TotalFound = #results
        UpdateStats()

        Log("", Color3.fromRGB(255, 255, 255))
        Log("🎉🎉🎉 TÌM THẤY NGAY TẠI SERVER NÀY! 🎉🎉🎉", Color3.fromRGB(255, 215, 0))
        for _, r in ipairs(results) do
            Log("  🏴‍☠️ " .. r.Name .. " [" .. r.Class .. "]", Color3.fromRGB(255, 180, 80))
            Log("     📍 " .. r.Path, Color3.fromRGB(130, 130, 160))
        end

        SetBigStatus("🎉", "TÌM THẤY RÂU ĐEN!", "Không cần hop! Server này có sẵn!", Color3.fromRGB(0, 255, 100))
        IsSearching = false
        return
    end

    if StopFlag then
        Log("⛔ Đã dừng.", Color3.fromRGB(255, 80, 80))
        IsSearching = false
        return
    end

    Log("❌ Server này không có. Bắt đầu auto hop...", Color3.fromRGB(255, 150, 80))
    Log("", Color3.fromRGB(255, 255, 255))

    -- Lấy server list
    Log("📡 Lấy danh sách server...", Color3.fromRGB(100, 200, 255))
    local servers = FetchServers()

    if #servers == 0 then
        Log("❌ Không tìm thấy server nào!", Color3.fromRGB(255, 80, 80))
        SetBigStatus("❌", "LỖI", "Không lấy được danh sách server!", Color3.fromRGB(255, 80, 80))
        IsSearching = false
        return
    end

    Log("📋 Tìm thấy " .. #servers .. " server khả dụng", Color3.fromRGB(100, 255, 100))
    Log("", Color3.fromRGB(255, 255, 255))

    -- Lưu config để tiếp tục sau teleport
    local hopConfig = {
        autoHop = true,
        currentHop = 0,
        maxHops = Settings.MaxHops,
        scanDelay = Settings.ScanDelay,
        customKeywords = CustomBox.Text,
        startTime = StartTime,
        mode = "blackbeard"
    }

    pcall(function()
        if writefile then
            writefile("BlackbeardHop_Config.json", HttpService:JSONEncode(hopConfig))
            Log("💾 Config đã lưu", Color3.fromRGB(150, 200, 255))
        end
    end)

    -- Chọn server ngẫu nhiên và hop
    HopCount = 1
    UpdateStats()
    local target = servers[math.random(1, #servers)]

    Log("🌐 HOP #1 → " .. string.sub(target.id, 1, 20) .. "...", Color3.fromRGB(255, 200, 100))
    Log("👥 Players: " .. target.playing .. "/" .. target.maxPlayers, Color3.fromRGB(150, 150, 170))

    SetBigStatus("🚀", "ĐANG TELEPORT...", "Hop #1 - Đang chuyển server...", Color3.fromRGB(255, 140, 0))

    task.wait(Settings.AutoHopDelay)

    if StopFlag then
        Log("⛔ Đã dừng trước khi teleport.", Color3.fromRGB(255, 80, 80))
        pcall(function() if delfile then delfile("BlackbeardHop_Config.json") end end)
        IsSearching = false
        return
    end

    Log("🚀 Teleporting...", Color3.fromRGB(255, 140, 0))

    pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, target.id)
    end)

    task.wait(10)
    Log("⚠️ Teleport có thể thất bại, thử thủ công.", Color3.fromRGB(255, 180, 0))
    SetBigStatus("⚠️", "CÓ THỂ LỖI", "Teleport timeout - thử lại!", Color3.fromRGB(255, 180, 0))
    IsSearching = false
end)

