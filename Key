task.spawn(function()
    task.wait(3)

    local savedConfig = nil
    pcall(function()
        if isfile and isfile("BlackbeardHop_Config.json") then
            savedConfig = HttpService:JSONDecode(readfile("BlackbeardHop_Config.json"))
        end
    end)

    if savedConfig and savedConfig.autoHop and savedConfig.mode == "blackbeard" then
        HopCount = (savedConfig.currentHop or 0) + 1
        StartTime = savedConfig.startTime or tick()
        IsSearching = true

        if savedConfig.customKeywords then
            CustomBox.Text = savedConfig.customKeywords
        end

        if HopCount > savedConfig.maxHops then
            Log("⛔ ĐÃ ĐẠT GIỚI HẠN " .. savedConfig.maxHops .. " HOPS!", Color3.fromRGB(255, 100, 100))
            Log("💡 Râu Đen không tìm thấy. Thử lại sau!", Color3.fromRGB(200, 200, 200))
            SetBigStatus("⛔", "HẾT LƯỢT HOP", "Đã hop " .. savedConfig.maxHops .. " lần không tìm thấy.", Color3.fromRGB(255, 150, 0))
            pcall(function() if delfile then delfile("BlackbeardHop_Config.json") end end)
            IsSearching = false
            UpdateStats()
            return
        end

        ClearLogs()

        local totalElapsed = math.floor(tick() - StartTime)

        Log("🔄 AUTO HOP - Lần #" .. HopCount, Color3.fromRGB(255, 200, 0))
        Log("⏱️ Tổng thời gian: " .. totalElapsed .. "s", Color3.fromRGB(150, 150, 170))
        Log("📍 Server mới: " .. string.sub(JobId, 1, 25) .. "...", Color3.fromRGB(150, 150, 170))
        Log("👥 Players: " .. #Players:GetPlayers(), Color3.fromRGB(150, 150, 170))
        Log("", Color3.fromRGB(255, 255, 255))

        SetBigStatus("⏳", "ĐANG ĐỢI GAME LOAD...", "Hop #" .. HopCount .. " - Chờ " .. savedConfig.scanDelay .. "s...", Color3.fromRGB(255, 200, 0))

        UpdateStats()

        -- Đợi game load
        Log("⏳ Đợi " .. savedConfig.scanDelay .. "s để game load...", Color3.fromRGB(200, 200, 255))

        for i = savedConfig.scanDelay, 1, -1 do
            if StopFlag then break end
            StatusDesc.Text = "Hop #" .. HopCount .. " - Còn " .. i .. "s..."
            task.wait(1)
        end

        if StopFlag then
            Log("⛔ Đã dừng.", Color3.fromRGB(255, 80, 80))
            pcall(function() if delfile then delfile("BlackbeardHop_Config.json") end end)
            IsSearching = false
            return
        end

        -- SCAN
        SetBigStatus("🔍", "ĐANG SCAN...", "Hop #" .. HopCount .. " - Quét tìm Râu Đen...", Color3.fromRGB(100, 200, 255))
        Log("🔍 Scanning...", Color3.fromRGB(100, 200, 255))

        local results, scanned = ScanForBlackbeard()
        Log("📊 Quét " .. scanned .. " objects", Color3.fromRGB(150, 150, 170))

        if #results > 0 then
            TotalFound = #results
            UpdateStats()

            Log("", Color3.fromRGB(255, 255, 255))
            Log("╔════════════════════════════════════════════╗", Color3.fromRGB(255, 215, 0))
            Log("║                                            ║", Color3.fromRGB(255, 215, 0))
            Log("║  🏴‍☠️🎉 TÌM THẤY RÂU ĐEN SAU " .. HopCount .. " LẦN HOP! 🎉🏴‍☠️ ║", Color3.fromRGB(255, 215, 0))
            Log("║                                            ║", Color3.fromRGB(255, 215, 0))
            Log("╚════════════════════════════════════════════╝", Color3.fromRGB(255, 215, 0))
            Log("", Color3.fromRGB(255, 255, 255))

            for _, r in ipairs(results) do
                Log("  🏴‍☠️ " .. r.Name .. " [" .. r.Class .. "]", Color3.fromRGB(255, 180, 80))
                Log("     📍 " .. r.Path, Color3.fromRGB(130, 130, 160))
                if r.Position then
                    Log("     🗺️ Pos: " .. r.Position, Color3.fromRGB(100, 200, 100))
                end
            end

            Log("", Color3.fromRGB(255, 255, 255))
            Log("✅ ĐÃ DỪNG AUTO HOP. Ở LẠI SERVER NÀY!", Color3.fromRGB(0, 255, 100))
            Log("⏱️ Tổng thời gian: " .. math.floor(tick() - StartTime) .. " giây", Color3.fromRGB(200, 200, 200))

            SetBigStatus("🏴‍☠️", "TÌM THẤY RÂU ĐEN!", "Sau " .. HopCount .. " hops (" .. math.floor(tick() - StartTime) .. "s)", Color3.fromRGB(0, 255, 100))

            StatusPanel.BackgroundColor3 = Color3.fromRGB(15, 35, 15)
            TweenService:Create(StatusStroke, TweenInfo.new(0.5), {Color = Color3.fromRGB(0, 255, 0)}):Play()

            pcall(function() if delfile then delfile("BlackbeardHop_Config.json") end end)

            -- Thông báo
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "🏴‍☠️ TÌM THẤY RÂU ĐEN!",
                    Text = "Sau " .. HopCount .. " lần hop! (" .. math.floor(tick() - StartTime) .. "s)",
                    Duration = 30
                })
            end)

            IsSearching = false
        else
            Log("❌ Không có. Hop tiếp... (" .. HopCount .. "/" .. savedConfig.maxHops .. ")", Color3.fromRGB(255, 150, 80))
            UpdateStats()

            -- Cập nhật config
            savedConfig.currentHop = HopCount
            pcall(function()
                if writefile then
                    writefile("BlackbeardHop_Config.json", HttpService:JSONEncode(savedConfig))
                end
            end)

            -- Hop tiếp
            task.wait(Settings.AutoHopDelay)
            Log("📡 Lấy server mới...", Color3.fromRGB(100, 200, 255))

            local servers = FetchServers()
            if #servers > 0 then
                local target = servers[math.random(1, #servers)]
                Log("🌐 Hop → " .. string.sub(target.id, 1, 20) .. "... (" .. target.playing .. "p)", Color3.fromRGB(255, 200, 100))

                SetBigStatus("🚀", "TELEPORTING...", "Hop #" .. (HopCount + 1) .. " - Chuyển server...", Color3.fromRGB(255, 140, 0))

                task.wait(1)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, target.id)
                end)

                task.wait(10)
                Log("⚠️ Teleport timeout!", Color3.fromRGB(255, 180, 0))
            else
                Log("❌ Không còn server! Dừng.", Color3.fromRGB(255, 80, 80))
                pcall(function() if delfile then delfile("BlackbeardHop_Config.json") end end)
            end

            IsSearching = false
        end
    end
end)

