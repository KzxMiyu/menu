-- ════════════════════════════════════════
-- HÀM SCAN TÌM RÂU ĐEN
-- ════════════════════════════════════════
local function GetAllKeywords()
    local keywords = {}
    -- Từ mặc định
    for _, kw in ipairs(Settings.BlackbeardKeywords) do
        table.insert(keywords, kw:lower())
    end
    -- Từ tùy chỉnh
    if CustomBox.Text ~= "" then
        for word in string.gmatch(CustomBox.Text, "([^,]+)") do
            word = word:match("^%s*(.-)%s*$")
            if word ~= "" then
                table.insert(keywords, word:lower())
            end
        end
    end
    return keywords
end

local function ScanForBlackbeard()
    local keywords = GetAllKeywords()
    local found = {}
    local scanned = 0

    -- ═══ SCAN WORKSPACE ═══
    pcall(function()
        for _, desc in ipairs(Workspace:GetDescendants()) do
            scanned = scanned + 1
            local name = desc.Name:lower()
            for _, kw in ipairs(keywords) do
                if string.find(name, kw, 1, true) then
                    local info = {
                        Name = desc.Name,
                        Class = desc.ClassName,
                        Path = desc:GetFullName(),
                        Keyword = kw,
                        Location = "Workspace"
                    }
                    -- Thêm vị trí nếu có
                    pcall(function()
                        if desc:IsA("BasePart") then
                            info.Position = tostring(desc.Position)
                        elseif desc:IsA("Model") and desc.PrimaryPart then
                            info.Position = tostring(desc.PrimaryPart.Position)
                        end
                    end)
                    table.insert(found, info)
                    break
                end
            end
        end
    end)

    -- ═══ SCAN REPLICATED STORAGE ═══
    pcall(function()
        for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
            scanned = scanned + 1
            local name = desc.Name:lower()
            for _, kw in ipairs(keywords) do
                if string.find(name, kw, 1, true) then
                    table.insert(found, {
                        Name = desc.Name,
                        Class = desc.ClassName,
                        Path = desc:GetFullName(),
                        Keyword = kw,
                        Location = "ReplicatedStorage"
                    })
                    break
                end
            end
        end
    end)

    -- ═══ SCAN PLAYER GUI ═══
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, desc in ipairs(playerGui:GetDescendants()) do
                scanned = scanned + 1
                local name = desc.Name:lower()
                for _, kw in ipairs(keywords) do
                    if string.find(name, kw, 1, true) then
                        table.insert(found, {
                            Name = desc.Name,
                            Class = desc.ClassName,
                            Path = desc:GetFullName(),
                            Keyword = kw,
                            Location = "PlayerGui"
                        })
                        break
                    end
                end
            end
        end
    end)

    -- ═══ KIỂM TRA ĐẶC BIỆT CHO BLOX FRUITS ═══
    
    -- Check NPCs
    pcall(function()
        local npcsFolder = Workspace:FindFirstChild("NPCs") or Workspace:FindFirstChild("Enemies")
        if npcsFolder then
            for _, npc in ipairs(npcsFolder:GetDescendants()) do
                local name = npc.Name:lower()
                if string.find(name, "blackbeard", 1, true) or
                   string.find(name, "darkbeard", 1, true) or
                   string.find(name, "dark beard", 1, true) then
                    table.insert(found, {
                        Name = npc.Name,
                        Class = npc.ClassName,
                        Path = npc:GetFullName(),
                        Keyword = "boss_npc",
                        Location = "NPCs"
                    })
                end
            end
        end
    end)

    -- Check Items trên đất
    pcall(function()
        local itemsFolder = Workspace:FindFirstChild("Items") or Workspace:FindFirstChild("DroppedItems")
        if itemsFolder then
            for _, item in ipairs(itemsFolder:GetChildren()) do
                local name = item.Name:lower()
                if string.find(name, "dark", 1, true) or
                   string.find(name, "key", 1, true) or
                   string.find(name, "fist", 1, true) or
                   string.find(name, "fragment", 1, true) then
                    table.insert(found, {
                        Name = item.Name,
                        Class = item.ClassName,
                        Path = item:GetFullName(),
                        Keyword = "item",
                        Location = "Items"
                    })
                end
            end
        end
    end)

    -- Loại trùng
    local unique = {}
    local seen = {}
    for _, f in ipairs(found) do
        if not seen[f.Path] then
            seen[f.Path] = true
            table.insert(unique, f)
        end
    end

    return unique, scanned
end

