-- TAB BUTTONS
------------------------------------------------

local TabFrame = Instance.new("Frame")
TabFrame.Parent = Main
TabFrame.Size = UDim2.new(0,120,1,-40)
TabFrame.Position = UDim2.new(0,0,0,40)
TabFrame.BackgroundColor3 = Color3.fromRGB(40,40,55)

local function CreateTab(name,pos)
local btn = Instance.new("TextButton")
btn.Parent = TabFrame
btn.Size = UDim2.new(1,0,0,40)
btn.Position = UDim2.new(0,0,0,pos)
btn.Text = name
btn.BackgroundColor3 = Color3.fromRGB(255,182,193)
btn.TextColor3 = Color3.new(1,1,1)
btn.Font = Enum.Font.GothamBold
btn.TextScaled = true

local c = Instance.new("UICorner")
c.Parent = btn
c.CornerRadius = UDim.new(0,8)

btn.MouseEnter:Connect(function()
TweenService:Create(btn,TweenInfo.new(0.2),{
BackgroundColor3 = Color3.fromRGB(255,120,200)
}):Play()
end)

btn.MouseLeave:Connect(function()
TweenService:Create(btn,TweenInfo.new(0.2),{
BackgroundColor3 = Color3.fromRGB(255,182,193)
}):Play()
end)

return btn
end

